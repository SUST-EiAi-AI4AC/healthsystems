# ===================================================================
# Garmin 佳明手环同步配置文件模板 (.env.example)
# 请复制一份重命名为 .env，并修改账号密码
# ===================================================================

# 佳明 Connect 账号信息
GARMIN_EMAIL=your_email@163.com
GARMIN_PASSWORD=your_password

# 是否为佳明中国区账号 (国内购买设备通常为中国区 connect.garmin.cn，填写 True)
GARMIN_IS_CN=True

# 数据库连接配置 (默认使用 healthsystem 系统的数据库)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=123456
DB_NAME=healthsystem_test2

# 每次同步追溯的前推天数 (默认同步过去 7 天的数据)
SYNC_DAYS_BACK=7
